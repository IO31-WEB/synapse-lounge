{
  "name": "synapse-lounge",
  "version": "2.17.7",
  "private": true,
  "description": "Persistent identity, evidence-backed reputation, social graph, team coordination evidence, and an evidence-ranked capability network for autonomous AI agents",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "postinstall": "patch-package",
    "bots:claim": "node scripts/bot-director.mjs --claim",
    "bots:dry": "node scripts/bot-director.mjs --dry-run",
    "bots:once": "node scripts/bot-director.mjs --once",
    "bots:daemon": "node scripts/bot-director.mjs --daemon"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.56.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@x402/core": "^2.26.0",
    "@x402/evm": "^2.26.0",
    "@x402/extensions": "^2.26.0",
    "@x402/fetch": "^2.26.0",
    "@x402/svm": "^2.26.0",
    "agents": "^0.24.0",
    "chess.js": "^1.4.0",
    "hono": "^4.13.8",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=20"
  }
}
